
import sqlite3
from pathlib import Path

# Database location
BASE_DIR = Path(__file__).resolve().parent
DATABASE = BASE_DIR / "finance.db"


# Connect to database
def get_db_connection():

    connection = sqlite3.connect(DATABASE)

    connection.row_factory = sqlite3.Row

    connection.execute("PRAGMA foreign_keys = ON")

    return connection


# Create database tables
def create_tables():

    connection = get_db_connection()

    cursor = connection.cursor()

    # Users table
    
    # Budgets Table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS budgets (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            category TEXT NOT NULL,
            monthly_limit REAL NOT NULL CHECK(monthly_limit > 0),
            month TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
            UNIQUE(category, month)
        )
    """)


    # Transactions table
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS transactions (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            type TEXT NOT NULL CHECK(type IN ('income', 'expense')),
            category TEXT NOT NULL,
            amount REAL NOT NULL CHECK(amount > 0),
            description TEXT,
            date TEXT NOT NULL,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,

            FOREIGN KEY (user_id)
            REFERENCES users(id)
            ON DELETE CASCADE
        )
    """)

    connection.commit()

    connection.close()

    print("Database tables created successfully!")


# Run database initialization
if __name__ == "__main__":

    create_tables()


# =================================
# Transaction Management Functions
# =================================


# 1. Add Transaction
def add_transaction(transaction_type, category, amount, description, date):

    connection = get_db_connection()

    connection.execute("""
        INSERT INTO transactions
        (user_id, type, category, amount, description, date)
        VALUES (?, ?, ?, ?, ?, ?)
    """, (
        None,
        transaction_type,
        category,
        amount,
        description,
        date
    ))

    connection.commit()
    connection.close()

    return True


# 2. Get All Transactions
def get_transactions():

    connection = get_db_connection()

    transactions = connection.execute("""
        SELECT * FROM transactions
        WHERE user_id IS NULL
        ORDER BY date DESC, id DESC
    """).fetchall()

    connection.close()

    return transactions


# 3. Calculate Financial Summary
def get_summary():

    connection = get_db_connection()

    summary = connection.execute("""
        SELECT
            COALESCE(SUM(CASE
                WHEN type = 'income' THEN amount
                ELSE 0
            END), 0) AS total_income,

            COALESCE(SUM(CASE
                WHEN type = 'expense' THEN amount
                ELSE 0
            END), 0) AS total_expenses

        FROM transactions
        WHERE user_id IS NULL
    """).fetchone()

    connection.close()

    total_income = summary["total_income"]
    total_expenses = summary["total_expenses"]

    return {
        "total_income": total_income,
        "total_expenses": total_expenses,
        "balance": total_income - total_expenses
    }


# 4. Delete Transaction
def delete_transaction(transaction_id):

    connection = get_db_connection()

    cursor = connection.execute("""
        DELETE FROM transactions
        WHERE id = ? AND user_id IS NULL
    """, (transaction_id,))

    connection.commit()

    deleted = cursor.rowcount > 0

    connection.close()

    return deleted


def get_expense_by_category():
    connection = get_db_connection()

    expenses = connection.execute("""
        SELECT
            category,
            SUM(amount) AS total
        FROM transactions
        WHERE type = 'expense'
        AND user_id IS NULL
        GROUP BY category
        ORDER BY total DESC
    """).fetchall()

    connection.close()
    return expenses


# =================================
# Budget Management Functions
# =================================

# 1. Add or Update Budget
def set_budget(category, monthly_limit, month):

    connection = get_db_connection()

    connection.execute("""
        INSERT INTO budgets (category, monthly_limit, month)
        VALUES (?, ?, ?)

        ON CONFLICT(category, month)
        DO UPDATE SET monthly_limit = excluded.monthly_limit
    """, (category, monthly_limit, month))

    connection.commit()
    connection.close()

    return True


# 2. Get Budgets with Actual Expenses
def get_budgets(month):

    connection = get_db_connection()

    budgets = connection.execute("""
        SELECT
            b.id,
            b.category,
            b.monthly_limit,
            b.month,
            COALESCE(SUM(t.amount), 0) AS spent

        FROM budgets b

        LEFT JOIN transactions t
            ON t.category = b.category
            AND t.type = 'expense'
            AND t.user_id IS NULL
            AND substr(t.date, 1, 7) = b.month

        WHERE b.month = ?

        GROUP BY
            b.id,
            b.category,
            b.monthly_limit,
            b.month

        ORDER BY b.category
    """, (month,)).fetchall()

    connection.close()

    result = []

    for budget in budgets:

        limit = budget["monthly_limit"]
        spent = budget["spent"]
        remaining = limit - spent

        percentage = (spent / limit) * 100

        result.append({
            "id": budget["id"],
            "category": budget["category"],
            "monthly_limit": limit,
            "spent": spent,
            "remaining": remaining,
            "percentage": round(percentage, 2),
            "month": budget["month"],
            "progress_width": min(percentage, 100),
        })

    return result

