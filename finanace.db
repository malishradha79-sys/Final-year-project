from ai_assistant import get_ai_response    
from flask import Flask, render_template, request, redirect, url_for, flash, jsonify
from database import (
    create_tables,
    get_transactions,
    get_summary,
    add_transaction,
    get_expense_by_category,
    set_budget,
    get_budgets,
    add_financial_goal,
    get_financial_goals,
    update_goal_savings,
    delete_financial_goal
)
from datetime import datetime

app = Flask(__name__)
app.secret_key = "fintrack-development-key"

create_tables()

@app.route("/")
def home():
    transactions = get_transactions()
    summary = get_summary()

    current_month = datetime.now().strftime("%Y-%m")
    budgets = get_budgets(current_month)

    return render_template(
        "index.html",
        transactions=transactions,
        summary=summary,
        budgets=budgets,
        current_month=current_month
    )


@app.route("/add-transaction", methods=["POST"])
def add_transaction_route():
    transaction_type = request.form.get("type", "").strip()
    category = request.form.get("category", "").strip()
    amount_text = request.form.get("amount", "").strip()
    description = request.form.get("description", "").strip()
    date = request.form.get("date", "").strip()

    # Validate transaction type
    if transaction_type not in ["income", "expense"]:
        flash("Please select a valid transaction type.")
        return redirect(url_for("home"))

    # Validate category
    if not category:
        flash("Please enter a category.")
        return redirect(url_for("home"))

    # Validate amount
    try:
        amount = float(amount_text)
        if amount <= 0:
            raise ValueError
    except (ValueError, TypeError):
        flash("Please enter a valid amount greater than zero.")
        return redirect(url_for("home"))

    # Validate date
    try:
        datetime.strptime(date, "%Y-%m-%d")
    except ValueError:
        flash("Please enter a valid date.")
        return redirect(url_for("home"))

    # Save transaction in SQLite
    add_transaction(
        transaction_type,
        category,
        amount,
        description,
        date
    )

    flash("Transaction added successfully!")
    return redirect(url_for("home"))


@app.route("/api/expense-summary")
def expense_summary():
    expenses = get_expense_by_category()

    return jsonify([
        {
            "category": expense["category"],
            "total": expense["total"]
        }
        for expense in expenses
    ])


@app.route("/add-budget", methods=["POST"])
def add_budget_route():

    category = request.form.get("category", "").strip()
    limit_text = request.form.get("monthly_limit", "").strip()

    if not category or len(category) > 50:
        flash("Please enter a valid category (maximum 50 characters).")
        return redirect(url_for("home"))

    try:
        monthly_limit = float(limit_text)

        if not monthly_limit > 0 or not monthly_limit < float("inf"):
            raise ValueError

    except (ValueError, TypeError):
        flash("Please enter a valid monthly budget.")
        return redirect(url_for("home"))

    current_month = datetime.now().strftime("%Y-%m")

    set_budget(category, monthly_limit, current_month)

    flash("Monthly budget saved successfully!")

    return redirect(url_for("home"))


@app.route("/ai-chat", methods=["POST"])
def ai_chat():
    data = request.get_json(silent=True) or {}

    user_message = data.get("message", "").strip()

    if not user_message:
        return jsonify({
            "reply": "Please enter a question."
        }), 400

    if len(user_message) > 1000:
        return jsonify({
            "reply": "Please keep your question within 1000 characters."
        }), 400

    # Get financial information from database
    summary = get_summary()

    current_month = datetime.now().strftime("%Y-%m")
    budgets = get_budgets(current_month)
    expenses = get_expense_by_category()

    # Prepare financial context for Gemini
    financial_context = f"""
    Current Month: {current_month}

    Total Income: Rs. {summary['total_income']}
    Total Expenses: Rs. {summary['total_expenses']}
    Available Balance: Rs. {summary['balance']}

    Expense Categories:
    """

    for expense in expenses:
        financial_context += (
            f"\n{expense['category']}: Rs. {expense['total']}"
        )

    financial_context += "\n\nMonthly Budgets:\n"

    for budget in budgets:
        financial_context += (
            f"\nCategory: {budget['category']}"
            f"\nBudget Limit: Rs. {budget['monthly_limit']}"
            f"\nSpent: Rs. {budget['spent']}"
            f"\nRemaining: Rs. {budget['remaining']}\n"
        )

    # Generate AI response
    answer = get_ai_response(
        user_message,
        financial_context
    )

    return jsonify({
        "reply": answer
    })

@app.route("/api/smart-insights", methods=["GET"])
def smart_insights():
    summary = get_summary()

    current_month = datetime.now().strftime("%Y-%m")
    budgets = get_budgets(current_month)
    expenses = get_expense_by_category()

    financial_context = f"""
    Current Month: {current_month}

    Total Income: Rs. {summary['total_income']}
    Total Expenses: Rs. {summary['total_expenses']}
    Available Balance: Rs. {summary['balance']}

    Expense Categories:
    """

    if expenses:
        for expense in expenses:
            financial_context += (
                f"\n{expense['category']}: Rs. {expense['total']}"
            )
    else:
        financial_context += "\nNo expense records available."

    financial_context += "\n\nMonthly Budgets:\n"

    if budgets:
        for budget in budgets:
            financial_context += (
                f"\nCategory: {budget['category']}"
                f"\nBudget Limit: Rs. {budget['monthly_limit']}"
                f"\nSpent: Rs. {budget['spent']}"
                f"\nRemaining: Rs. {budget['remaining']}"
                f"\nUsed: {budget['percentage']}%\n"
            )
    else:
        financial_context += "\nNo monthly budgets have been set."

    prompt = """
    Analyse the user's financial information.

    Give 4 short and useful spending insights.
    Focus on high spending categories, budget warnings,
    available balance, and practical saving suggestions.

    Use only the supplied financial information.
    Do not invent numbers or assume missing information.
    Use simple English and bullet points.
    """

    answer = get_ai_response(prompt, financial_context)

    return jsonify({"insights": answer})




if __name__ == "__main__":
    app.run(debug=True)
